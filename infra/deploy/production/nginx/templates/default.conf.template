server {
    listen 80;
    server_name ${WEB_DOMAIN} ${API_DOMAIN} ${ADMIN_DOMAIN} ${WS_DOMAIN};

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${WEB_DOMAIN};
    ssl_certificate ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    include /etc/nginx/includes/proxy-common.conf;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # User-uploaded files returned by the API as /api-storage/*.
    # Keep this on the web domain so frontend avatar URLs stay same-origin.
    location ^~ /api-storage/ {
        rewrite ^/api-storage/(.*)$ /storage/$1 break;
        proxy_pass http://api:8000;
    }

    location / {
        proxy_pass http://web:3000;
    }
}

server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};
    ssl_certificate ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    include /etc/nginx/includes/proxy-common.conf;
    client_max_body_size 50m;

    location / {
        proxy_pass http://api:8000;
    }
}

server {
    listen 443 ssl http2;
    server_name ${ADMIN_DOMAIN};
    ssl_certificate ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    include /etc/nginx/includes/proxy-common.conf;

    location / {
        proxy_pass http://admin-web:3001;
    }
}

server {
    listen 443 ssl http2;
    server_name ${WS_DOMAIN};
    ssl_certificate ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    include /etc/nginx/includes/proxy-common.conf;

    location /app/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_pass http://reverb:8080;
    }
}
