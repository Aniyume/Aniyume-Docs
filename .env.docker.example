# Docker local/dev defaults. Copy to `.env.docker.local` for private overrides if needed.
# Do not put real production secrets into this committed example.

APP_NAME=Aniyume
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

LOG_CHANNEL=stack
LOG_LEVEL=debug

POSTGRES_DB=aniyume
POSTGRES_USER=aniyume
POSTGRES_PASSWORD=aniyume_local_password

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aniyume
DB_USERNAME=aniyume
DB_PASSWORD=aniyume_local_password

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=aniyume-local
REVERB_APP_KEY=local-reverb-key-change-me
REVERB_APP_SECRET=local-reverb-secret-change-me
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:3000,http://127.0.0.1:8088,http://127.0.0.1:3000

CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:3000,http://127.0.0.1:8088,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Requested-With,X-XSRF-TOKEN,X-Fingerprint-ID
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

BACKEND_URL=http://backend:8000/api/v1
NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key-change-me
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8088
NEXT_PUBLIC_REVERB_SCHEME=http

NGINX_PUBLISHED_PORT=8088
FRONTEND_PUBLISHED_PORT=3000
BACKEND_PUBLISHED_PORT=8000
REVERB_PUBLISHED_PORT=8080
DB_PUBLISHED_PORT=5433
REDIS_PUBLISHED_PORT=6379

# Future admin app placeholder; no aniyume-admin container exists in this phase.
ADMIN_BACKEND_URL=http://backend:8000/api/v1
